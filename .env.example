# ─────────────────────────────────────────────────────────────
# SnapEnvoice waitlist — environment configuration
# Copy this file to `.env.local` and fill in the values you use.
# Everything is OPTIONAL. With nothing set, the API stores signups
# in a local JSON file (dev only) so you can test end-to-end.
# ─────────────────────────────────────────────────────────────

# How many free "first-mover" spots to offer (the 3-months-free promo).
NEXT_PUBLIC_WAITLIST_CAP=500

# Public launch date (ISO). Powers the countdown. Leave blank to hide it.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-01T09:00:00-07:00

# ── Option A: Supabase (recommended for a DIY backend) ──────────
# Create a table `waitlist (id uuid pk default gen_random_uuid(),
#   email text unique not null, trade text, created_at timestamptz default now())`
# Use the SERVICE ROLE key here (server-side only — never expose it).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Option B: Forward to any webhook (GetWaitlist, Zapier, Make) ─
# If set, each signup is POSTed here as { email, trade, ts }.
WAITLIST_WEBHOOK_URL=

# ── Option C: Resend (send the welcome/confirmation email) ──────
RESEND_API_KEY=
RESEND_FROM="SnapEnvoice <hello@snapenvoice.app>"
